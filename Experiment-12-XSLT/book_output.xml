<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Aditi Digital Library</title>

<style>
body{
    font-family:Verdana;
    background:#fff5f7;
    padding:20px;
}

h2{
    text-align:center;
    background:#f4a6c1;
    color:white;
    padding:15px;
    border-radius:12px;
    width:60%;
    margin:auto;
}

table{
    border-collapse:collapse;
    width:80%;
    margin:30px auto;
    background:white;
    box-shadow:0 5px 15px rgba(0,0,0,0.1);
}

th{
    background:#f4a6c1;
    color:white;
    padding:12px;
}

td{
    padding:10px;
    text-align:center;
}

tr:nth-child(even){
    background:#fff0f5;
}

tr:hover{
    background:#fde2eb;
}
</style>

</head>

<body>

<h2>Aditi Digital Library</h2>

<table border="1">

<tr>
    <th>Title</th>
    <th>Author</th>
    <th>Country</th>
    <th>Year</th>
    <th>Price</th>
</tr>

<tr>
    <td>Atomic Habits</td>
    <td>James Clear</td>
    <td>USA</td>
    <td>2018</td>
    <td>450</td>
</tr>

<tr>
    <td>Think and Grow Rich</td>
    <td>Napoleon Hill</td>
    <td>USA</td>
    <td>1937</td>
    <td>399</td>
</tr>

<tr>
    <td>Ignited Minds</td>
    <td>A.P.J Abdul Kalam</td>
    <td>India</td>
    <td>2002</td>
    <td>350</td>
</tr>

<tr>
    <td>The Psychology of Money</td>
    <td>Morgan Housel</td>
    <td>USA</td>
    <td>2020</td>
    <td>499</td>
</tr>

<tr>
    <td>Ikigai</td>
    <td>Hector Garcia</td>
    <td>Japan</td>
    <td>2016</td>
    <td>420</td>
</tr>

</table>

</body>
</html>
